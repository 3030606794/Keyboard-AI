<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- For top persistent status banner (fallback to toast if not granted). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application android:name=".KGPTApplication" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.KGPT" android:usesCleartextTraffic="true" android:hardwareAccelerated="true" android:requestLegacyExternalStorage="true" tools:targetApi="31" android:multiArch="true">

        <activity android:name=".ui.main.MainActivity" android:exported="true" android:theme="@style/Theme.KGPT" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".core.ui.DialogActivity" android:theme="@style/Theme.KGPT.Translucent" android:excludeFromRecents="true" android:taskAffinity="" android:exported="true">
            <intent-filter>
                <action android:name="tn.eluea.kgpt.OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".features.websearch.WebSearchActivity" android:theme="@style/Theme.KGPT.WebSearch" android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="stateHidden|adjustResize" android:exported="false" />

        <activity android:name=".ui.lab.LabActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <activity android:name=".ui.lab.apptrigger.AppTriggerActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <activity android:name=".ui.lab.textactions.TextActionsActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <!-- Role management (full screen, replaces previous bottom-sheet UI) -->
        <activity android:name=".ui.roles.RolesSettingsActivity" android:theme="@style/Theme.KGPT" android:exported="false" />
        <activity
            android:name=".ui.roles.RoleEditActivity"
            android:theme="@style/Theme.KGPT"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity android:name=".ui.lab.StreamingNonLinearModelSettingsActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <!-- In-app AI chat (testing console) -->
        <activity
            android:name=".ui.chat.AiChatActivity"
            android:theme="@style/Theme.KGPT"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Floating Screenshot → Ask AI settings -->
        <activity
            android:name=".ui.lab.screenshotask.ScreenshotAskActivity"
            android:theme="@style/Theme.KGPT"
            android:exported="false" />

        <activity
            android:name=".ui.chat.ChatSessionsActivity"
            android:theme="@style/Theme.KGPT"
            android:exported="false" />

        <activity android:name=".ui.settings.BlurControlActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <activity android:name=".ui.settings.MaterialYouSettingsActivity" android:theme="@style/Theme.KGPT" android:exported="false" />

        <activity android:name=".ui.settings.UpdateSettingsActivity" android:theme="@style/Theme.KGPT" android:exported="false" />



        <activity android:name=".features.textactions.ui.TextActionsMenuActivity" android:theme="@style/Theme.KGPT.TextActionsMenu" android:excludeFromRecents="true" android:exported="false" />

        
        <activity android:name=".features.textactions.ui.ProcessTextActivity" android:theme="@style/Theme.KGPT.Translucent" android:excludeFromRecents="true" android:icon="@mipmap/ic_launcher" android:label="@string/ui_process_text_label" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>


<activity android:name=".features.textactions.ui.ProcessTextClipboardActivity"
    android:theme="@style/Theme.KGPT.Translucent"
    android:excludeFromRecents="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/ui_process_text_clipboard_label"
    android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
    </intent-filter>
</activity>

        <service android:name=".core.network.InternetService" android:exported="true">
            <intent-filter>
                <action android:name="tn.eluea.kgpt.INTERNET_SERVICE" />
            </intent-filter>
        </service>

        <!-- Floating overlay bubble: tap to screenshot and ask AI -->
        <service
            android:name=".core.ui.FloatingAskAiService"
            android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled screenshot assistant overlay" />
        </service>

        <provider
            android:name=".provider.ConfigProvider"
            android:authorities="tn.eluea.kgpt.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".provider.BootReceiver" android:directBootAware="true" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".receiver.TextActionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="tn.eluea.kgpt.TEXT_ACTION_REQUEST" />
            </intent-filter>
        </receiver>

        <receiver android:name=".receiver.GeneratingStatusBridgeReceiver" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="tn.eluea.kgpt.action.GENERATING_STATUS_BRIDGE" />
            </intent-filter>
        </receiver>

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Integrate Generative AI like ChatGPT in keyboard." />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
    <activity android:name=".ui.settings.LanguageSelectionActivity" android:theme="@style/Theme.KGPT" android:exported="false" />



        </application>

</manifest>